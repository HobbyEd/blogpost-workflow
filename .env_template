# ==============================================================================
# Blogpost Workflow — omgevingsvariabelen
# Kopieer naar '.env' en vul de lege velden in. '.env' staat in .gitignore.
# Geen geheimen in dit bestand; alleen namen en ongevaarlijke defaults.
# ==============================================================================

# --- Grok / xAI (fase 3, MCP-server .claude/mcp/grok_review_server.py) ---
GROK_API_KEY=
GROK_MODEL=grok-4.3
# Optioneel. Alleen nodig om het prepaid-saldo in de UI te tonen.
# Aanmaken: console.x.ai → Settings → Management Keys. Niet dezelfde als GROK_API_KEY.
# XAI_MANAGEMENT_KEY=

# --- WordPress (fase 6, scripts/deploy_post.py) ---
# Application Password uit wp-admin → Profiel. Mag spaties bevatten.
WP_SITE_URL=https://edwinvandillen.nl
WP_USERNAME=edwin
WP_APPLICATION_TOKEN=

# --- Beheer-API (web Settings / RAG-herindex) ---
ADMIN_TOKEN=

# --- Graphify (semantische extractie van documenten) ---
# Optioneel. Zonder key extraheert de host-agent zelf.
GEMINI_API_KEY=
# GRAPHIFY_GEMINI_MODEL=gemini-2.5-flash

# --- Optioneel, alleen zetten als je afwijkt van de default ---
# BLOGPOST_POSTS_DIR=          # anders: <repo>/posts
# CLAUDE_BIN=                  # anders: claude op PATH, of ~/.local/bin/claude
# CHROME=                      # anders: bekende paden in scripts/render_svg.py
