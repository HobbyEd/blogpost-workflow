# ==============================================================================
# Blogpost Workflow Environment Configuration Template (.env_template)
# Kopieer dit bestand naar '.env' en vul de onderstaande variabelen in.
# Het bestand '.env' is opgetomen in .gitignore en wordt nooit geversioneerd.
# ==============================================================================

# Grok / xAI API Configuration
# Vereist voor Fase 3 (Grok Reviewer) via de lokale MCP server.
GROK_API_KEY=
GROK_MODEL=grok-4.3

# WordPress Configuration & Credentials
# Vereist voor Fase 6 (Deploy als concept via WordPress REST API).
WP_SITE_URL=https://edwinvandillen.nl
WP_USERNAME=edwin
WP_APPLICATION_TOKEN=

# Admin Security Token Configuration
# Token voor beheerdersacties, beheer-API beveiliging en geavanceerde functionaliteiten.
ADMIN_TOKEN=
admin_token=

